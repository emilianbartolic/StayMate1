# Booking.com Demand API credentials (must be issued for an approved partner account).
# Copy this file to backend/.env and fill it locally. Never commit backend/.env.
BOOKING_DEMAND_API_KEY=
BOOKING_DEMAND_AFFILIATE_ID=

# Optional. Defaults to the production API. For an authorized sandbox account use:
# BOOKING_DEMAND_API_BASE=https://demandapi-sandbox.booking.com/3.3

# Local host management login. If no password is set, first startup creates a
# random password in user-data/local-admin-credentials.txt (file mode 0600).
STAYMATE_LOCAL_ADMIN_EMAIL=host@staymate.local
STAYMATE_LOCAL_ADMIN_PASSWORD=
# Optional. If unset, a random private key is created beside the SQLite DB.
STAYMATE_SESSION_SECRET=

# Model availability, concurrency, and retention controls.
STAYMATE_MODEL_ENABLED=1
STAYMATE_MODEL_CALLS_PER_DAY=300
STAYMATE_MODEL_MAX_CONCURRENT=2
STAYMATE_TICKET_RETENTION_DAYS=90
STAYMATE_AUDIT_RETENTION_DAYS=90
STAYMATE_PENDING_MEMORY_RETENTION_DAYS=30
STAYMATE_MEMORY_RETENTION_DAYS=365
STAYMATE_BACKUP_RETENTION_DAYS=90
